# ============================================
# Student Tracker Pro - Конфигурация
# ============================================

# Supabase Configuration
# Получите эти значения в Dashboard вашего Supabase проекта:
# https://app.supabase.com/project/_/settings/api

# URL вашего Supabase проекта
# Пример: https://abcdefghijk.supabase.co
VITE_SUPABASE_URL=

# Anon key (публичный ключ) вашего Supabase проекта
# Начинается с "eyJ..." и очень длинный
# ВАЖНО: Используйте именно anon key, НЕ service_role key!
VITE_SUPABASE_ANON_KEY=

# ============================================
# Инструкции по настройке:
# ============================================
# 
# 1. Создайте проект на https://supabase.com
# 2. Выполните миграцию из supabase/migrations/001_initial_schema.sql
# 3. Скопируйте Project URL и anon key
# 4. Заполните этот файл
# 5. Перезапустите dev-сервер: npm run dev
# 
# Подробная инструкция: README.md → "Настройка Supabase"
# ============================================
